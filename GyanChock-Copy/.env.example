# ── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/gyan-chowk

# ── Cloudinary (server only — never expose the secret) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Razorpay (server only — never expose the secret) ────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Initial admin bootstrap (hashed before insert) ──────
ADMIN_EMAIL=admin@gyanchowk.com
ADMIN_PASSWORD=change-this-strong-password

# ── App URLs ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development

# ── Optional email (architecture-ready) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Gyan Chowk <noreply@gyanchowk.com>

# ── Platform finance ────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=20
