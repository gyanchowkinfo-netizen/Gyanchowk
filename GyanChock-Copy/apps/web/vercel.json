{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "[ -L node_modules ] && rm -f node_modules; npm install --prefix ../.. --include=dev --install-strategy=nested",
  "buildCommand": "npm run build:web --prefix ../..",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gyanchowk-1.onrender.com/api/:path*"
    }
  ]
}
